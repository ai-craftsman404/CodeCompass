{
  "name": "codecompass",
  "version": "1.0.0",
  "description": "Contextual project audit skill with parameterized questionnaire and precedence-based rule recommendations",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPattern='src/tests/(?!e2e-)' --coverage",
    "test:e2e": "jest --testPathPattern='src/tests/e2e-'",
    "test:all": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "build": "tsc",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "audit",
    "compliance",
    "project-analysis",
    "code-quality",
    "ai-patterns"
  ],
  "author": "CodeCompass Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
